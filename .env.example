# ตัวอย่างไฟล์ตั้งค่า — คัดลอกเป็น .env.local แล้วเติมค่าจริง
# ใช้ชุดเดียวกันนี้ใน Vercel > Project Settings > Environment Variables

# Supabase (project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Apps Script web app ที่ใช้ซิงค์ข้อมูล
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/your-script-id/exec
NEXT_PUBLIC_GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/your-script-id/exec

# รหัสผ่านเข้าใช้งาน (ใช้ร่วมกันทั้ง admin และ teacher)
APP_PASSWORD=change-me-before-deploy

# รหัสผ่านเฉพาะโหมดผู้ดูแลระบบ (ถ้าไม่ตั้ง จะใช้ค่าเดียวกับ APP_PASSWORD)
ADMIN_PASSWORD=change-admin-mode-password

# กุญแจเซ็น session cookie — สุ่มใหม่ด้วยคำสั่ง:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ถ้าไม่ตั้งค่า ระบบจะใช้ค่า fallback ที่ไม่ปลอดภัย
AUTH_SECRET=replace-with-64-hex-characters
